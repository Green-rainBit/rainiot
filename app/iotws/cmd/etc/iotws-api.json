{
  "Name": "iotws-api",
  "Host": "0.0.0.0",
  "Port": 8888,
  "Log": {
    "Mode": "file",
    "Path": "logs/iotws-api"
  },
  "Loki": {
    "Enable": false,
    "Mode": "direct",
    "Url": "http://localhost:3100",
    "SourceName": "rainiot",
    "JobName": "iotws-api",
    "Console": true
  },
  "CacheRedis": {
    "type": "cluster",
    "Host": "",
    "Pass": ""
  },
  "Rpc": {
    "Model": "instances"
  },
  "DeviceServerMap": {},
  "mq": {
