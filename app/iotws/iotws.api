syntax = "v1"

type Request {
	ConnId string `form:"connId,optional"`
}

type Response {
	Cmd  string `json:"cmd"`
	Data string `json:"data"`
}

type Notice {
	ConnId   string `json:"connId"`
	MessgeId string `json:"messgeId"`
	Data     string `json:"data"`
}

type WsBalanced {
	Targeted string `json:"targeted"`
}

service iotws-api {
	@handler IotwsHandler
	get /connect (Request)

	@handler IotNoticeHandler
	post /notice (Notice)

	@handler IotPingHandler
	get /ping (Request)
}

